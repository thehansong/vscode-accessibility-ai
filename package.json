{
  "name": "vscode-accessibility-ai",
  "displayName": "Accessibility AI Highlighter",
  "description": "Highlights specific characters/patterns in open editors",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "accessibilityHighlighter.analyzeWithOllama",
        "title": "Analyze Text with Ollama"
      },
      {
        "command": "accessibilityHighlighter.reloadOllamaConfig",
        "title": "Reload Ollama Configuration"
      }
    ],
    "configuration": {
      "title": "Accessibility AI Highlighter",
      "properties": {
        "accessibilityHighlighter.pattern": {
          "type": "string",
          "default": "a(?=bc)",
          "description": "Regex pattern to highlight (default: 'a' in 'abc')"
        },
        "accessibilityHighlighter.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable highlighting"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "openai": "^6.16.0"
  }
}
